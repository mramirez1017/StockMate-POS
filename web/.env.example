VITE_FIREBASE_API_KEY=your-api-key
# Default Firebase auth domain (required for Google sign-in).
# To use your web.app domain instead, add this redirect URI in Google Cloud Console
# (Credentials → Web client): https://YOUR-PROJECT.web.app/__/auth/handler
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXX
VITE_USE_EMULATORS=false
